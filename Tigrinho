 
package br.eti.vargas.tigrinho_desafio;

import java.util.Random;

import java.util.Scanner;

/**
 *
 * @author sesi2dia
 */
       public class Tigrinho_desafio {

       public static void main(String[] args) {
             
 

       Scanner entrada = new Scanner(System.in);
        Random aleatorio = new Random();

        int[] mSorteio = new int[30];

        // Preenche o array com números aleatórios de 0 a 100
        for (int i = 0; i < mSorteio.length; i++) {
            mSorteio[i] = aleatorio.nextInt(101);
        }

        // Mostra os números sorteados (apenas para testar)
        System.out.println("Números sorteados:");
        for (int i = 0; i < mSorteio.length; i++) {
            System.out.print(mSorteio[i] + " ");
        }

        System.out.println("\n");

        int acertos = 0;

        // Solicita 4 números ao usuário
        for (int i = 0; i < 4; i++) {

            System.out.print("Digite o " + (i + 1) + "º número (0 a 100): ");
            int numero = entrada.nextInt();

            // Procura o número no array
            for (int j = 0; j < mSorteio.length; j++) {
                if (numero == mSorteio[j]) {
                    acertos++;
                    break;
                }
            }
        }

        // Calcula a porcentagem
        int porcentagem = acertos * 25;

        System.out.println("\nQuantidade de acertos: " + acertos);
        System.out.println("Porcentagem do ganho: " + porcentagem + "%");

        entrada.close();
    }
}

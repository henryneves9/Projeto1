ESTILO.CSS
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: rgb(170, 209, 253);
    color: aliceblue;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 60px 20px;
}

.container {
    background-color: rgb(50, 122, 204);
    width: 100%;
    max-width: 600px;
    padding: 30px;
    box-shadow: 0px 20px 20px #928bff;
    border-radius: 28px;
    border: 2px solid #090357;
}

header {
    margin-bottom: 40px;
    border-left: 4px solid #ffe031;
    padding-left: 15px;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    text-align: center;
    color: #090357;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding-bottom: 20px;
    border-bottom: 1px solid #928bff;
}

td {
    padding: 15px 10px;
    font-size: 14px;
    border-bottom: 1px solid #090357;
}

tbody tr {
    transition: background-color 0.3s;
}

tbody tr:hover {
    cursor: pointer;
    background-color: #09035655;
}

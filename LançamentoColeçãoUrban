Style.css
/* --- RESET & BASICS --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', system-ui, -apple-system, sans-serif;
    background-color: #0d0d11;
    color: #ffffff;
    line-height: 1.4;
}

/* --- HERO / BANNER PRINCIPAL --- */
.hero {
    min-height: 70vh;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, #0d0d11 100%),
                url('https://images.unsplash.com/photo-1509631179647-0177331693ae?w=1000') center/cover no-repeat;
    display: flex;
    align-items: flex-end;
    padding: 40px 20px;
    text-align: center;
}

.hero-content {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
}

.hero .tag {
    background-color: #ff0055;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 1px;
}

.hero h1 {
    font-size: 2.2rem;
    font-weight: 900;
    margin: 15px 0 10px;
    text-transform: uppercase;
    letter-spacing: -1px;
    color: #fff;
}

.hero p {
    font-size: 1rem;
    color: #cccccc;
    margin-bottom: 20px;
}

.btn-main {
    display: inline-block;
    width: 100%;
    padding: 16px;
    background-color: #00f0ff;
    color: #000;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 12px;
    transition: transform 0.2s ease, background-color 0.2s;
}

.btn-main:active {
    transform: scale(0.98);
}

/* --- CONTAINER & VITRINE --- */
.container {
    padding: 30px 20px 60px;
    max-width: 1200px;
    margin: 0 auto;
}

.container h2 {
    font-size: 1.5rem;
    text-transform: uppercase;
    margin-bottom: 20px;
    letter-spacing: 1px;
    border-left: 4px solid #ff0055;
    padding-left: 10px;
}

/* Grelha Mobile First (sem barra de rolagem horizontal) */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
}

/* --- CARTÃO DE PRODUTO --- */
.product-card {
    background-color: #16161e;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #262635;
}

.product-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.product-info {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.product-info h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: #eeeeee;
}

.product-info .price {
    font-size: 1.1rem;
    font-weight: 800;
    color: #00f0ff;
}

.btn-buy {
    width: 100%;
    padding: 10px;
    background-color: #ff0055;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 0.8rem;
}

/* --- MEDIA QUERIES (DESKTOP & TABLET) --- */
@media (min-width: 768px) {
    .hero h1 {
        font-size: 3.5rem;
    }

    .hero p {
        font-size: 1.2rem;
    }

    .btn-main {
        width: auto;
        padding: 16px 40px;
    }

    .product-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .product-info h3 {
        font-size: 1.1rem;
    }
}
